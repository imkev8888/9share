# ============================================================================
# 9share — environment variables
# Copy to .env.local for local dev. In production, set these in Vercel.
# ============================================================================

# Your app's public URL.
#   Local:      http://localhost:3000
#   Production: https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Instagram (Meta App) ---------------------------------------------------
# From Meta App Dashboard > Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
# Any random string you choose. Paste the SAME value into the Meta dashboard
# "Verify token" field when configuring the webhook.
INSTAGRAM_VERIFY_TOKEN=9share_super_secret_verify_token

# --- Facebook (Meta App) ----------------------------------------------------
# From Meta App Dashboard > App settings > Basic (the FACEBOOK app id/secret,
# not the Instagram ones above).
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Any random string you choose. Paste the SAME value into the Meta dashboard
# "Verify token" field when configuring the Page webhook.
FACEBOOK_VERIFY_TOKEN=9share_super_secret_fb_verify_token

# --- Supabase ---------------------------------------------------------------
# From Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin ------------------------------------------------------------------
ADMIN_EMAILS=kev@boostteamhk.com

# --- Threads (Meta App) -----------------------------------------------------
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- LinkedIn ---------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- RedNote MCP (Xiaohongshu) ----------------------------------------------
XHS_MCP_URL=http://localhost:18060/mcp
XHS_MCP_SECRET=

# --- WeChat Moments MCP -----------------------------------------------------
WECHAT_MCP_URL=http://localhost:8765/sse
WECHAT_MCP_SECRET=
